# Production configuration template.
#
# Copy to a location OUTSIDE the document root, e.g. /home/USER/.mailgen/env,
# then: chmod 600 /home/USER/.mailgen/env
#
# passenger_wsgi.py sets MAILGEN_ENV_FILE to that path by default.
# Never commit the filled-in file.

# --- Django core ------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_50_RANDOM_CHARS
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_SECURE_SSL_REDIRECT=1
# Enable HSTS only after HTTPS is confirmed working on the subdomain.
DJANGO_HSTS_SECONDS=0

# --- Database (created in cPanel » MySQL Databases) -------------------------
DB_ENGINE=mysql
DB_NAME=cpuser_mailgen
DB_USER=cpuser_mailgen
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=3306

# --- Encryption key for stored mailbox passwords ---------------------------
# Generate: python manage.py generate_field_key
# Losing this key makes stored mailbox passwords unreadable.
MAILGEN_FIELD_KEY=CHANGE_ME_FERNET_KEY

# --- Address policy ---------------------------------------------------------
MAILGEN_ADDRESS_DOMAIN=example.com
MAILGEN_ADDRESS_PREFIX=otp-
MAILGEN_ADDRESS_LENGTH=10
MAILGEN_FORWARD_TO=primary@example.com
MAILGEN_MAX_ADDRESSES=10
MAILGEN_QUOTA_MB=100

# --- cPanel UAPI ------------------------------------------------------------
# cPanel » Security » Manage API Tokens. Full-account power: keep this file 0600.
CPANEL_BASE_URL=https://server.example.com:2083
CPANEL_USER=cpuser
CPANEL_TOKEN=CHANGE_ME
CPANEL_TIMEOUT=25
CPANEL_VERIFY_TLS=1

# --- IMAP -------------------------------------------------------------------
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_TIMEOUT=25
IMAP_VALIDATE_CERT=1
IMAP_SYNC_BATCH=5
IMAP_MAX_MESSAGES=100

# --- Sessions / throttling --------------------------------------------------
MAILGEN_SESSION_IDLE_SECONDS=1800
MAILGEN_SESSION_ABSOLUTE_SECONDS=43200
MAILGEN_LOGIN_MAX_ATTEMPTS=5
MAILGEN_LOGIN_WINDOW_SECONDS=900

# --- Logging ----------------------------------------------------------------
MAILGEN_LOG_DIR=/home/USER/.mailgen/logs
