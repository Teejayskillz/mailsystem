# Production configuration template.
#
# Copy to a location OUTSIDE the document root, e.g. /home/USER/.mailgen/env,
# then: chmod 600 /home/USER/.mailgen/env
#
# passenger_wsgi.py sets MAILGEN_ENV_FILE to that path by default.
# Never commit the filled-in file.

# --- Django core ------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# HTTPS redirect is on by default when DEBUG=0. Set 0 only for local HTTP tests.
# DJANGO_SECURE_SSL_REDIRECT=1
# Enable HSTS only after HTTPS is confirmed working on the subdomain.
DJANGO_HSTS_SECONDS=0

# --- Database (one line) ----------------------------------------------------
# Create the database and user in cPanel » MySQL Databases.
DATABASE_URL=mysql://cpuser_mailgen:CHANGE_ME@localhost:3306/cpuser_mailgen?charset=utf8mb4
# SQLite alternative for a throwaway local run:
# DATABASE_URL=sqlite:///db.sqlite3

# --- Secrets (different purposes — keep both) -------------------------------
# Session/CSRF signing key:
DJANGO_SECRET_KEY=CHANGE_ME_50_RANDOM_CHARS
# Mailbox-password encryption key (generate: python manage.py generate_field_key):
MAILGEN_FIELD_KEY=CHANGE_ME_FERNET_KEY

# --- Address policy (one line) ----------------------------------------------
# Supported parameters: domain, prefix, length, forward_to, max_addresses, quota_mb
# The domain may also be the URL host: mailgen://example.com?...
MAILGEN_URL=mailgen://example.com?prefix=otp-&length=10&forward_to=primary@example.com&max_addresses=10&quota_mb=100

# --- cPanel UAPI (separate credentials, never in a URL) ---------------------
# cPanel » Security » Manage API Tokens. Full-account power: keep this file 0600.
CPANEL_BASE_URL=https://server.example.com:2083
CPANEL_USER=cpuser
CPANEL_TOKEN=CHANGE_ME
# Optional tuning:
# CPANEL_TIMEOUT=25
# CPANEL_VERIFY_TLS=1
# CPANEL_CA_BUNDLE=/home/USER/.mailgen/ca.pem

# --- IMAP (hostname only; the mailbox password is created by the app) ------
IMAP_HOST=mail.example.com
# Optional tuning:
# IMAP_PORT=993
# IMAP_ENCRYPTION=ssl
# IMAP_TIMEOUT=25
# IMAP_VALIDATE_CERT=1
# IMAP_SYNC_BATCH=5
# IMAP_MAX_MESSAGES=100

# --- Optional tuning --------------------------------------------------------
# MAILGEN_SESSION_IDLE_SECONDS=1800
# MAILGEN_SESSION_ABSOLUTE_SECONDS=43200
# MAILGEN_LOGIN_MAX_ATTEMPTS=5
# MAILGEN_LOGIN_WINDOW_SECONDS=900
# MAILGEN_LOG_DIR=/home/USER/.mailgen/logs

# --- Legacy individual variables (still supported; override MAILGEN_URL) ---
# MAILGEN_ADDRESS_DOMAIN=example.com
# MAILGEN_ADDRESS_PREFIX=otp-
# MAILGEN_ADDRESS_LENGTH=10
# MAILGEN_FORWARD_TO=primary@example.com
# MAILGEN_MAX_ADDRESSES=10
# MAILGEN_QUOTA_MB=100
# DB_ENGINE=mysql
# DB_NAME=cpuser_mailgen
# DB_USER=cpuser_mailgen
# DB_PASSWORD=CHANGE_ME
# DB_HOST=localhost
# DB_PORT=3306
